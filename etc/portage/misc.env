*/* ccache.conf
dev-java/openjdk-* no-ccache.conf #FEATURES=ccache doesn't work with openjdk, bug #677876
sys-kernel/gentoo-kernel no-binpkg.conf

dev-games/aseprite network-errors-during-build.conf
www-apps/hugo network-errors-during-build.conf
app-misc/pup network-errors-during-build.conf
media-libs/zrythm network-errors-during-build.conf no-mold.conf

*/* mold.conf
# These packages are required to build mold
app-arch/zstd no-mold.conf
dev-cpp/tbb no-mold.conf
dev-libs/blake3 no-mold.conf
virtual/zlib no-mold.conf
dev-libs/mimalloc no-mold.conf
app-alternatives/ninja no-mold.conf
dev-build/cmake no-mold.conf

# These packages produce errors with mold
app-misc/radeontop no-mold.conf
sys-libs/glibc no-mold.conf
dev-libs/libxml2 no-mold.conf
media-sound/vgmplay no-mold.conf
app-editors/kakoune no-mold.conf
app-shells/fzf no-mold.conf
app-shells/dash no-mold.conf
sys-kernel/* no-mold.conf
media-sound/helm no-mold.conf

dev-util/github-cli network-errors-during-build.conf
net-libs/libmicrohttpd no-binpkg.conf
